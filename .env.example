# Copy to a private, ignored .env file on the presenter machine; replace placeholders.
# In Bash, export it with: set -a; . ./.env; set +a
# Do not auto-select the Azure CLI default as the expected ID: that defeats the guard.
MMS_SUBSCRIPTION_ID='<your-session-host-update-subscription-guid>'
MMS_TENANT_ID='<your-session-host-update-tenant-guid>'
MMS_AVD_HYBRID_SUBSCRIPTION_ID='<your-avd-hybrid-subscription-guid>'
